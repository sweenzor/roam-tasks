{
  "name": "roam-tasks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fast local task manager backed by Roam Research's desktop local API.",
  "main": "electron/main.mjs",
  "scripts": {
    "build:icon": "node scripts/build-icons.mjs",
    "build:mac": "npm run build:icon && node scripts/build-macos-app.mjs",
    "dev": "electron .",
    "electron": "electron .",
    "fallback:docker": "docker compose up --build",
    "fallback:docker:down": "docker compose down",
    "server": "node server/index.mjs",
    "start": "electron .",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^41.4.0"
  }
}
