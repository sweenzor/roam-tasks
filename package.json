{
  "name": "roam-tasks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fast local task manager backed by Roam Research's desktop local API.",
  "scripts": {
    "dev": "node server/index.mjs",
    "start": "node server/index.mjs",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "test:integration": "RUN_ROAM_INTEGRATION_TESTS=1 node --test test/integration/*.test.mjs",
    "docker:build": "docker build -t roam-tasks ."
  },
  "engines": {
    "node": ">=20"
  }
}
