# Optional fallback if you do not use ~/.roam-tools.json.
# Prefer `npx @roam-research/roam-mcp connect` or the Roam desktop UI token flow.
ROAM_GRAPH=
ROAM_GRAPH_NICKNAME=default
ROAM_GRAPH_TYPE=hosted
ROAM_LOCAL_API_TOKEN=roam-graph-local-token-
ROAM_DEFAULT_GRAPH=
ROAM_LOCAL_API_HOST=127.0.0.1
ROAM_LOCAL_API_PORT=3333

# Optional app port.
PORT=5874
HOST=127.0.0.1
